// screens/music.slint — player de WAVs do cartão (L3): falante local
// (ES8311) e/ou USB (UAC1), conforme a rota SOM.2 (auto/falante/USB).
import { ListView, Slider } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { TonalButton, GhostButton, FilledButton } from "../elements/buttons.slint";
import { Surface, ScreenTitle } from "../elements/surfaces.slint";

export component MusicScreen inherits Rectangle {
    in property <[string]> tracks;
    in property <string> dev;
    in property <string> state;
    in property <string> track;
    in property <string> route: "auto";
    in-out property <float> volume: 60;
    in property <string> vol-label: "falante";
    callback set-route(int);
    callback volume-set(float);
    callback play(int);
    callback stop();
    callback pause();
    callback next();
    callback refresh();
    callback go-back();

    HorizontalLayout {
        padding: Theme.sp-lg;
        spacing: Theme.sp-md;

        VerticalLayout {
            width: 320px;
            spacing: Theme.sp-sm;
            HorizontalLayout {
                spacing: Theme.sp-sm;
                ScreenTitle { label: "Música"; horizontal-stretch: 1; }
                TonalButton { width: 44px; h: Theme.btn-h-sm; fsize: Theme.type-label; text: "Att"; clicked => { root.refresh(); } }
            }
            Surface {
                level: 1;
                vertical-stretch: 1;
                clip: true;
                ListView {
                    width: 100%;
                    height: 100%;
                    for t[i] in root.tracks: Rectangle {
                        height: 40px;
                        clip: true;
                        Text {
                            x: Theme.sp-sm;
                            text: t;
                            color: Theme.on-surface;
                            font-size: Theme.type-body;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: Theme.state-pressed;
                            visible: ta.pressed;
                            border-radius: Theme.shape-sm;
                            opacity: 10%;
                        }
                        ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            clicked => { root.play(i); }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.outline-var; }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-sm;
            Text {
                text: "Saída: " + root.dev;
                color: Theme.on-surface-var;
                font-size: Theme.type-label;
            }
            HorizontalLayout {
                spacing: Theme.sp-sm;
                GhostButton { horizontal-stretch: 1; fsize: Theme.type-label; text: "auto"; clicked => { root.set-route(0); } }
                GhostButton { horizontal-stretch: 1; fsize: Theme.type-label; text: "falante"; clicked => { root.set-route(1); } }
                GhostButton { horizontal-stretch: 1; fsize: Theme.type-label; text: "USB"; clicked => { root.set-route(2); } }
            }
            Text {
                text: "Faixa: " + root.track;
                color: Theme.on-surface;
                font-size: Theme.type-body;
                wrap: word-wrap;
            }
            Text {
                text: "Estado: " + root.state;
                color: Theme.tertiary;
                font-size: Theme.type-body;
            }
            HorizontalLayout {
                spacing: Theme.sp-sm;
                Text {
                    text: "Vol " + root.vol-label;
                    color: Theme.on-surface-var;
                    font-size: Theme.type-label;
                    vertical-alignment: center;
                }
                Slider {
                    minimum: 0; maximum: 100; step: 1;
                    value <=> root.volume;
                    horizontal-stretch: 1;
                    changed value => { root.volume-set(root.volume); }
                }
                Text {
                    text: "" + Math.round(root.volume);
                    width: 40px;
                    color: Theme.on-surface;
                    font-size: Theme.type-label;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                }
            }
            HorizontalLayout {
                spacing: Theme.sp-sm;
                FilledButton { horizontal-stretch: 1; text: "Parar"; clicked => { root.stop(); } }
                GhostButton { horizontal-stretch: 1; text: "Próxima"; clicked => { root.next(); } }
            }
            HorizontalLayout {
                spacing: Theme.sp-sm;
                TonalButton { horizontal-stretch: 1; text: "Pausar/Seguir"; clicked => { root.pause(); } }
            }
            HorizontalLayout {
                spacing: Theme.sp-sm;
                GhostButton { horizontal-stretch: 1; text: "Voltar"; clicked => { root.go-back(); } }
            }
            Text {
                text: "WAV PCM16 em /pda/music/ (44k1/48k). Rota vale na próxima faixa.";
                font-size: Theme.type-tiny;
                color: Theme.on-surface-var;
                wrap: word-wrap;
            }
        }
    }
}
